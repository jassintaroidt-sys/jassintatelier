{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Master data for fashion products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "normalPrice": { "type": "number" },
        "promoPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "rackLocation": { "type": "string" },
        "description": { "type": "string" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku": { "type": "string" },
              "size": { "type": "string" },
              "color": { "type": "string" },
              "stock": { "type": "number" },
              "physicalStock": { "type": "number" },
              "availableStock": { "type": "number" },
              "reservedStock": { "type": "number" },
              "damagedStock": { "type": "number" },
              "transitStock": { "type": "number" },
              "qcHold": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "sku", "name", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Sales orders from various platforms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "platform": { "type": "string" },
        "trackingCode": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productSku": { "type": "string" },
              "productName": { "type": "string" },
              "qty": { "type": "number" },
              "price": { "type": "number" },
              "size": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "customerName", "status", "platform"]
    },
    "StockHistory": {
      "title": "StockHistory",
      "description": "Logs of stock movements and adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productSku": { "type": "string" },
        "productName": { "type": "string" },
        "variantSize": { "type": "string" },
        "variantColor": { "type": "string" },
        "date": { "type": "string" },
        "changeQty": { "type": "number" },
        "type": { "type": "string" },
        "notes": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["id", "productSku", "date", "type"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger of income and expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "notes": { "type": "string" },
        "platform": { "type": "string" }
      },
      "required": ["id", "date", "type", "amount"]
    },
    "Karyawan": {
      "title": "Karyawan",
      "description": "Employee profiles and attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "commissionRate": { "type": "number" }
      },
      "required": ["id", "name", "role"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of fashion products"
    },
    "orders": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "stockHistory": {
      "schema": "StockHistory",
      "description": "Collection of stock movement logs"
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Collection of financial transactions"
    },
    "karyawan": {
      "schema": "Karyawan",
      "description": "Collection of employee data"
    }
  }
}
